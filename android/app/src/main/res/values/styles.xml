<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <!-- Без системного подчёркивания: рамку полю рисует TextField
             (src/components/TextField). underlineColorAndroid="transparent"
             линию не убирал — при заданной рамке фон поля пересобирается,
             и цветовой фильтр до подчёркивания не доходит.
             Нужны оба атрибута: ReactEditText — это AppCompatEditText, он
             читает фон из атрибута AppCompat `editTextBackground`, а не из
             системного `android:editTextBackground`. -->
        <item name="editTextBackground">@android:color/transparent</item>
        <item name="android:editTextBackground">@android:color/transparent</item>
        <!-- Без этого до загрузки JS в ночной теме видно чёрное окно. -->
        <item name="android:windowBackground">@color/app_background</item>
    </style>

</resources>
